<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.View.Home.BMRActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:titleCentered="false"
        app:titleTextAppearance="@style/toolbarTitle"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textInputData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Input Data"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_cekhasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/textInputData">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background_kalori"
            android:layout_gravity="center_horizontal"
            android:elevation="4dp">

            <!-- Input Fields -->
            <EditText
                android:id="@+id/usia"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:hint="Usia"
                android:inputType="number"
                android:background="@drawable/field_background"
                android:padding="12dp"
                android:layout_marginTop="20dp"
                android:textSize="16sp"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/beratBadan"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:hint="Berat Badan (kg)"
                android:inputType="number"
                android:background="@drawable/field_background"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/tinggiBadan"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:hint="Tinggi Badan (cm)"
                android:inputType="number"
                android:background="@drawable/field_background"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textColorHint="#777777" />

            <!-- Jenis Kelamin -->
            <RadioGroup
                android:id="@+id/genderRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="50dp"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/radioPria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pria"
                    android:textColor="#000000"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/radioWanita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wanita"
                    android:textColor="#000000"/>
            </RadioGroup>


            <!-- Submit Button -->
            <Button
                android:id="@+id/cekHasilButton"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Cek Hasil"
                android:backgroundTint="#237516"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
