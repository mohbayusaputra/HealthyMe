<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.View.Prediksi.PrediksiFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:titleCentered="true"
        app:titleTextAppearance="@style/toolbarTitle"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/textInputData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Input Data"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_cekhasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/textInputData">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/form_background"
            >

            <EditText
                android:id="@+id/input_kalori"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Kalori"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/input_protein"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Protein"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/input_fat"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Lemak"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/input_karbohidrat"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Karbohidrat"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:padding="12dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:textSize="16sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnCekHasil"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Cek Hasil"
                android:backgroundTint="#237516"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/card_cekhasil">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/result_background">

            <TextView
                android:id="@+id/textHasil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hasil:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data tersebut masuk ke Cluster 0 (Makanan rendah kalori dan protein atau makanan ringan)"
                android:textSize="16sp"
                android:textColor="#777777" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>