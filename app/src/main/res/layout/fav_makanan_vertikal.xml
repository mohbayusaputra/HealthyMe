<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:backgroundTint="#FFFFFF"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Image -->
            <ImageView
                android:id="@+id/foto_makanan"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/salad_image"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nama_makanan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salad Sayur"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_fire"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/nilai_kalori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="294 kcal"
                        android:textSize="12sp"
                        android:textColor="#777777" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bookmark Icon -->
            <ImageView
                android:id="@+id/bookmark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bookmark_fav"
                android:layout_gravity="top|end" />
        </LinearLayout>

        <!-- Nutrition Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Protein -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Value -->
                <TextView
                    android:id="@+id/nilai_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 g"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_protein"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="25dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_protein"
                    android:rotation="270" />

                <!--                         Label -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Protein"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>



            <!-- Fats -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Value -->
                <TextView
                    android:id="@+id/nilai_fat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22g"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_fat"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="25dp"
                    android:max="100"
                    android:rotation="270"
                    android:progressDrawable="@drawable/progress_fats" />

                <!-- Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Fats"
                    android:textSize="12sp"
                    android:textColor="#777777" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Value -->
                <TextView
                    android:id="@+id/nilai_karbohidrat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42g"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_karbohidrat"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="25dp"
                    android:max="100"
                    android:rotation="270"
                    android:progressDrawable="@drawable/progress_carbs" />

                <!-- Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Carbs"
                    android:textSize="12sp"
                    android:textColor="#777777" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>